# STAGE 1: Builder
# Purpose: Download dependencies and build them in an isolated virtual environment.
FROM python:3.11-alpine AS builder

# Optional: Install build dependencies (like gcc or musl-dev) 
# if your requirements.txt contains packages that need compiling from C.
# RUN apk add --no-cache build-base

# Create a Python virtual environment
RUN python -m venv /opt/venv

# Ensure all subsequent pip commands use this virtual environment
ENV PATH="/opt/venv/bin:$PATH"

# Copy the requirements file
COPY requirements.txt .

# Install dependencies into the virtual environment
RUN pip install --no-cache-dir -r requirements.txt


# STAGE 2: Runtime
# Purpose: Run the application without build tools or pip cache.
FROM python:3.11-alpine

# DevSecOps Best Practice: Create a non-root system user and group
RUN addgroup -S appuser && adduser -S appuser -G appuser

# Set the working directory
WORKDIR /app

# The Magic Step: Copy ONLY the compiled virtual environment from the builder stage
COPY --from=builder /opt/venv /opt/venv

# Ensure the production container uses the copied virtual environment
ENV PATH="/opt/venv/bin:$PATH"

# Copy the actual application code
COPY app.py .

# Change ownership of the app directory to the non-root user
RUN chown -R appuser:appuser /app

# Enforce security by switching from the 'root' user to our restricted user
USER appuser:appuser

# Expose the port Gunicorn will listen on
EXPOSE 5000

# Command to run the application using Gunicorn
CMD ["gunicorn", "-w", "2", "-b", "0.0.0.0:5000", "app:app"]
